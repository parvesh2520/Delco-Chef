# Local development only: copy to mobile/.env. Only public values belong here: EXPO_PUBLIC_* is bundled into the app.
# EAS cloud builds do NOT read this file (it is git-ignored); preview/production builds get their values from eas.json.

# FastAPI base URL (must include /api/v1).
#   Android emulator:  http://10.0.2.2:8000/api/v1
#   Physical device:   http://<your-PC-LAN-IP>:8000/api/v1   (phone and PC on the same Wi-Fi)
#   Deployed backend:  https://<service>.onrender.com/api/v1  (use this to test a dev build against Render)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# development | preview | production (development shows the "OTP is in the server log" hint)
EXPO_PUBLIC_APP_ENV=development

# Set to false if no Google Maps key is configured; a stylised map is shown instead.
EXPO_PUBLIC_MAPS_ENABLED=true

# Build-time only (read by app.config.js, not bundled as EXPO_PUBLIC). Restrict the key in Google Cloud.
GOOGLE_MAPS_API_KEY=
