# Delco Chefs API — copy to .env and fill in. Never commit .env.
ENVIRONMENT=development            # development | test | production
DEBUG=false
GIT_COMMIT=dev                     # set by CI/deploy; served at /version
PUBLIC_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=[]            # e.g. ["https://admin.example.com"]; native apps need no CORS

# Neon: pooled connection for the app, direct connection for Alembic migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Secrets. Generate each 32-byte key with:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=change-me-long-random-string
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes
HMAC_LOOKUP_KEY=change-me-base64-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP delivery: "log" = mock provider (development writes the code to the server log).
OTP_PROVIDER=log

# Razorpay TEST mode (rzp_test_… keys only). Leave empty in development to use the local sandbox gateway.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SANDBOX_WEBHOOK_SECRET=change-me-dev-only

# Photos/documents/exports. Local disk (mount a volume in Docker).
MEDIA_ROOT=media
RUN_WORKERS=true
