# Delco Chefs Backend Configuration
PROJECT_NAME="Delco Chefs API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="delco_user"
POSTGRES_PASSWORD="delco_password"
POSTGRES_DB="delco_chefs_db"
DATABASE_URL="postgresql://delco_user:delco_password@localhost:5432/delco_chefs_db"

# CORS Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["*"]

# Security (Placeholder for JWT secret)
SECRET_KEY="temporary-dev-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
