# Delco Chefs API: copy to .env for local development and fill in. Never commit .env.
# On Render, set these in the service's Environment tab instead (docs/RENDER_DEPLOYMENT_GUIDE.md has the full table).
# Names below are exactly what the code reads (app/core/config.py). JWTs use SECRET_KEY with HS256 (fixed in code).

# ---- Runtime ----
ENVIRONMENT=development            # development | test | production (production refuses weak secrets, hides OTPs)
DEBUG=false                        # true only for local debugging (DEBUG log level). Always false on Render
GIT_COMMIT=dev                     # optional; CI passes it as a build arg. On Render, RENDER_GIT_COMMIT is used automatically
PUBLIC_BASE_URL=http://localhost:8000   # public origin of this API (Razorpay redirect, sandbox checkout). Render: https://<service>.onrender.com
BACKEND_CORS_ORIGINS=[]            # browser origins only, e.g. ["https://admin.example.com"]. The native app needs none
RUN_WORKERS=true                   # in-process background jobs (outbox, link expiry, offer timeouts, location flush)
RUN_MIGRATIONS=false               # Docker only: run "alembic upgrade head" before starting (docker-compose sets true)
LOG_FILE=server.log                # optional: also append logs to this file. Leave unset on Render (it keeps stdout logs)

# ---- Database (Neon) ----
# Pooled connection for the app; direct (non-pooler) connection for Alembic. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require
DB_POOL_SIZE=5                     # Render free instance: 3
DB_MAX_OVERFLOW=5                  # Render free instance: 2
DB_PREFER_IPV4=false               # true only where IPv6 to the database times out

# ---- Secrets ----
# Generate each 32-byte key with:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# FIELD_ENCRYPTION_KEY and HMAC_LOOKUP_KEY must stay the same for an existing database: changing them makes stored
# phone numbers and documents unreadable and breaks login lookups.
SECRET_KEY=change-me-long-random-string       # signs access tokens (JWT, HS256)
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes
HMAC_LOOKUP_KEY=change-me-base64-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- OTP ----
OTP_PROVIDER=log                   # mock provider: writes the code to the server log (not in production, see below)
OTP_LOG_CODES=false                # production demo without SMS: true writes codes to the log. Never for real users

# ---- Razorpay (TEST mode, rzp_test_ keys only) ----
# Empty in development = local sandbox gateway. Required in production (the sandbox refuses to run there).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=           # same string as the webhook secret in the Razorpay dashboard; empty = all webhooks rejected
SANDBOX_WEBHOOK_SECRET=change-me-dev-only

# ---- Files ----
MEDIA_ROOT=media                   # local disk store, used when S3_BUCKET is empty. Wiped on every Render deploy/restart
# Persistent PRIVATE storage (S3-compatible). Set all of these to use it; the bucket must not be public.
S3_BUCKET=                         # e.g. delco-chefs-media
S3_ENDPOINT_URL=                   # Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com ; AWS S3: leave empty
S3_REGION=auto                     # R2: auto ; AWS: your bucket's region, e.g. ap-south-1
S3_ACCESS_KEY_ID=                  # sensitive
S3_SECRET_ACCESS_KEY=              # sensitive
